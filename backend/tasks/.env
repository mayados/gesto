# Valeurs par défaut NON SECRÈTES, versionnées pour que le service démarre sur un clone propre.
# Les vraies valeurs (APP_SECRET, DATABASE_URL) viennent de l'environnement du conteneur
# (voir docker-compose.yml) : elles écrasent celles de ce fichier.
APP_ENV=prod
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
