# TEST : essais en local, valeurs fictives sans importance.
# Copier ce modèle en .env.test (non versionné), puis :
#   docker compose -p gesto-test --env-file .env.test up -d --build
# Mots de passe : lettres et chiffres uniquement.

# Port du site : http://localhost:8080
FRONTEND_PORT=8080

# Sessions
JWT_SECRET=JwtSecretTest2026Gesto0123456789abcdef
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# Base de données
DB_ROOT_PASSWORD=RootPassTest2026
ACCOUNTS_DB_PASSWORD=AccountsPassTest2026
PROJECTS_DB_PASSWORD=ProjectsPassTest2026
TASKS_DB_PASSWORD=TasksPassTest2026

# Secrets Symfony (services PHP)
PROJECTS_APP_SECRET=ProjectsAppSecretTest0123456789ab
TASKS_APP_SECRET=TasksAppSecretTest0123456789abcd

# Compte administrateur créé au démarrage
ADMIN_EMAIL=admin@gesto.local
ADMIN_PASSWORD=AdminPassTest2026

# Limites de ressources par service (CPU en coeurs, mémoire)
FRONTEND_CPUS=0.25
FRONTEND_MEM=128M
ACCOUNTS_CPUS=0.50
ACCOUNTS_MEM=256M
PROJECTS_CPUS=0.50
PROJECTS_MEM=256M
TASKS_CPUS=0.50
TASKS_MEM=256M
DB_CPUS=1.00
DB_MEM=512M
