# UAT (recette) : copie la plus fidèle possible de la production.
# Remplacer TOUTES les valeurs ChangeMe par des mots de passe alphanumériques propres à cet environnement.
# Copier ce modèle en .env.uat (non versionné), puis :
#   docker compose -p gesto-uat --env-file .env.uat up -d --build
# Mots de passe : lettres et chiffres uniquement.

# Port du site : http://localhost:8081
FRONTEND_PORT=8081

# Sessions
JWT_SECRET=ChangeMeJwtSecretUat2026Gesto0123456789abcdef
JWT_EXPIRES_IN=2h
COOKIE_SECURE=true

# Base de données
DB_ROOT_PASSWORD=ChangeMeRootPassUat2026
ACCOUNTS_DB_PASSWORD=ChangeMeAccountsPassUat2026
PROJECTS_DB_PASSWORD=ChangeMeProjectsPassUat2026
TASKS_DB_PASSWORD=ChangeMeTasksPassUat2026

# Secrets Symfony (services PHP)
PROJECTS_APP_SECRET=ChangeMeProjectsAppSecretUat0123456789ab
TASKS_APP_SECRET=ChangeMeTasksAppSecretUat0123456789abcd

# Compte administrateur créé au démarrage
ADMIN_EMAIL=admin@gesto.local
ADMIN_PASSWORD=ChangeMeAdminPassUat2026

# Limites de ressources par service (CPU en coeurs, mémoire)
FRONTEND_CPUS=0.25
FRONTEND_MEM=128M
ACCOUNTS_CPUS=0.50
ACCOUNTS_MEM=256M
PROJECTS_CPUS=0.50
PROJECTS_MEM=256M
TASKS_CPUS=0.50
TASKS_MEM=256M
DB_CPUS=1.00
DB_MEM=512M
