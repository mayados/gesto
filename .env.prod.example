# PROD : fichier réel NON versionné. Remplacer TOUTES les valeurs ChangeMe.
# Sur un vrai serveur, FRONTEND_PORT serait 80 (derrière un HTTPS) ; 8082 évite un conflit en local.
# Copier ce modèle en .env.prod (non versionné), puis :
#   docker compose -p gesto-prod --env-file .env.prod up -d --build
# Mots de passe : lettres et chiffres uniquement.

# Port du site : http://localhost:8082
FRONTEND_PORT=8082

# Sessions
JWT_SECRET=ChangeMeJwtSecretProd2026Gesto0123456789abcdef
JWT_EXPIRES_IN=2h
COOKIE_SECURE=true

# Base de données
DB_ROOT_PASSWORD=ChangeMeRootPassProd2026
ACCOUNTS_DB_PASSWORD=ChangeMeAccountsPassProd2026
PROJECTS_DB_PASSWORD=ChangeMeProjectsPassProd2026
TASKS_DB_PASSWORD=ChangeMeTasksPassProd2026

# Secrets Symfony (services PHP)
PROJECTS_APP_SECRET=ChangeMeProjectsAppSecretProd0123456789ab
TASKS_APP_SECRET=ChangeMeTasksAppSecretProd0123456789abcd

# Compte administrateur créé au démarrage
ADMIN_EMAIL=admin@gesto.local
ADMIN_PASSWORD=ChangeMeAdminPassProd2026

# Limites de ressources par service (CPU en coeurs, mémoire)
FRONTEND_CPUS=0.50
FRONTEND_MEM=256M
ACCOUNTS_CPUS=1.00
ACCOUNTS_MEM=512M
PROJECTS_CPUS=1.00
PROJECTS_MEM=512M
TASKS_CPUS=1.00
TASKS_MEM=512M
DB_CPUS=2.00
DB_MEM=1G
